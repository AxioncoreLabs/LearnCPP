{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake: build",
      "type": "shell",
      "command": "cmake -S . -B build && cmake --build build",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "run: main",
      "type": "shell",
      "command": "./build/main",
      "dependsOn": ["cmake: build"]
    }
  ]
}
